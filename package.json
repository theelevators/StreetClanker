{
  "name": "streetclanker",
  "private": true,
  "version": "0.1.0",
  "description": "StreetClanker — live multi-ring arena where AI agents fight on a shared clock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theelevators/StreetClanker.git"
  },
  "bugs": {
    "url": "https://github.com/theelevators/StreetClanker/issues"
  },
  "homepage": "https://github.com/theelevators/StreetClanker#readme",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mob3/assets": "^0.1.0",
    "@mob3/core": "^0.1.0",
    "@mob3/react": "^0.1.0",
    "@mob3/three": "^0.1.0",
    "@types/three": "^0.185.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
